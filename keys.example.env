# TEMPLATE ONLY. Do not put real keys in this file or anywhere in this folder.
#
# Copy it OUTSIDE the project, then fill in the copy:
#
#   cp keys.example.env ~/.junction-keys.env
#   chmod 600 ~/.junction-keys.env
#
# The code reads ~/.junction-keys.env and refuses any keys file that sits
# inside a git repository. Every model is reached through an OpenAI-compatible
# endpoint, so a role is three lines: address, model name, key.

# Planter: writes the planted bugs. Use the strongest model you have, and
# never the same model as a reviewer.
PLANTER_BASE_URL=
PLANTER_MODEL=
PLANTER_API_KEY=

# Reviewer 1: the main reviewer under test.
REVIEWER_BASE_URL=
REVIEWER_MODEL=
REVIEWER_API_KEY=

# Reviewer 2 (optional): tested on the same planted bugs as reviewer 1.
# We use Google Gemini 4 Hydrogen through the Gemini API. The address and the
# model name below are public; only the key is secret. Get the key from Timo,
# one-to-one, never in a group chat.
# Leave REVIEWER2_MODEL empty to skip it. REVIEWER3 and REVIEWER4 work the same way.
REVIEWER2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
REVIEWER2_MODEL=gemini-4-hydrogen
REVIEWER2_API_KEY=

# Optional limits per reviewer, for REVIEWER_ and REVIEWER2_ alike (defaults in brackets):
#   _MAX_DIFF_CHARS    how much of a large change the reviewer is shown (120000)
#   _MAX_TOKENS        room for the reply, thinking included (16000)
#   _WORKERS           reviews run at once; lower it if the service rate-limits (4)
#   _TIMEOUT_SECONDS   how long to wait for one reply (600)
# What we use, measured on Saturday 14 November:
#   REVIEWER_MAX_DIFF_CHARS=400000
#   REVIEWER_MAX_TOKENS=45000      Nemotron thinks long; 45000 keeps its slowest review near 2 minutes
#   REVIEWER_WORKERS=13            13 at once were served in a careful probe, without refusals
#   REVIEWER2_MAX_DIFF_CHARS=400000
#   REVIEWER2_MAX_TOKENS=32000
#   REVIEWER2_WORKERS=16           far below the Gemini API limits shown in Google AI Studio
#   REVIEWER2_TIMEOUT_SECONDS=600
# The planter sends PLANTER_WORKERS requests at once (3).
