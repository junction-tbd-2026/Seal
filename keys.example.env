# TEMPLATE ONLY. Do not put real keys in this file or anywhere in this folder.
#
# Copy it OUTSIDE the project, then fill in the copy:
#
#   cp keys.example.env ~/.junction-keys.env
#   chmod 600 ~/.junction-keys.env
#
# The code reads ~/.junction-keys.env and refuses any keys file that sits
# inside a git repository.

# Planter: the model that writes the planted bugs.
PLANTER_BASE_URL=https://api.openai.com/v1
PLANTER_MODEL=
PLANTER_API_KEY=

# Reviewer under test. Any OpenAI-compatible endpoint works.
# NVIDIA's endpoint is https://integrate.api.nvidia.com/v1 (confirm the exact
# Nemotron model id at the NVIDIA table before relying on it).
REVIEWER_BASE_URL=https://integrate.api.nvidia.com/v1
REVIEWER_MODEL=
REVIEWER_API_KEY=
